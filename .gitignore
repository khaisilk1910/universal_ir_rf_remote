# Python / generated bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Tests, linting, coverage, type checking
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments / local configuration
.venv/
venv/
env/
ENV/
.python-version
.env
.env.*
!.env.example

# Python packaging / build output
build/
dist/
*.egg-info/
.eggs/
*.whl
*.egg
pip-wheel-metadata/

# IDE / editors
.idea/
.vscode/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db
Desktop.ini

# Logs / local exports / temporary files
*.log
*.log.*
*.tmp
*.bak
*.orig
*.zip
*.tar.gz

# Home Assistant runtime and backups (never publish credentials or user data)
.storage/
**/.storage/
secrets.yaml
**/secrets.yaml
home-assistant.log*
home-assistant_v2.db*
*.db-shm
*.db-wal
backups/
**/backups/

# Keep project files tracked:
# .github/, hacs.json, manifest.json, translations/, and brand/ are NOT ignored.
